########################################
# Java / Maven
########################################
**/target/
**/*.class
**/*.log
**/hs_err_pid*
**/.classpath
**/.project
**/.settings/

########################################
# Test reports / Allure
########################################
**/allure-results/
**/allure-report/
**/.allure/
**/.allure-results/

########################################
# OS junk
########################################
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

########################################
# IntelliJ / IDEA
########################################
.idea/
*.iml
*.iws
*.ipr
out/

########################################
# Node (dependencies only, NOT source)
########################################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

########################################
# Keep local API server tracked (code + lockfiles)
# Repo path: tools/my-api-server/
########################################
!tools/my-api-server/
!tools/my-api-server/**
tools/my-api-server/node_modules/

########################################
# Optional: dotenv / local env files
########################################
.env
.env.*